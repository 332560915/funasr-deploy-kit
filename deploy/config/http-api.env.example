# HTTP API 服务显示名称，会出现在 Swagger 和根路径响应中。
APP_NAME=FunASR HTTP API

# HTTP API 服务版本号，仅用于接口展示。
APP_VERSION=1.0.0

# API 路由前缀。识别接口默认为 /api/v1/asr。
API_PREFIX=/api/v1

# HTTP API 连接 FunASR Server 的 websocket 地址。
# 在 Docker Compose 网络内使用服务名 funasr-server。
FUNASR_WS_URL=ws://funasr-server:10095

# FunASR 识别模式。文件转写场景默认使用 offline。
FUNASR_MODE=offline

# 等待 FunASR 返回最终识别结果的超时时间，单位：秒。
FUNASR_FINAL_TIMEOUT=120

# HTTP 请求整体超时时间，单位：秒。
REQUEST_TIMEOUT=360

# HTTP keep-alive 连接保持时间，单位：秒。
TIMEOUT_KEEP_ALIVE=360

# HTTP API worker 进程数。当前采用异步模型，默认单进程即可。
HTTP_API_WORKERS=1

# HTTP 层最大并发连接/任务数。该值不是业务队列，只用于保护 HTTP 入口。
HTTP_API_LIMIT_CONCURRENCY=20

# 单个 worker 处理达到该请求数后重启，用于降低长期运行的内存碎片或资源泄漏影响。
HTTP_API_LIMIT_MAX_REQUESTS=1000

# TCP 等待队列大小，用于吸收瞬时连接峰值。
HTTP_API_BACKLOG=256

# 同时允许进入 FunASR 识别的业务并发数。
# FunASR Server 当前可承载较高并发，默认放到 10；后续可根据测试结果调整。
ASR_RECOGNITION_CONCURRENCY=10

# 同步识别接口上传文件大小上限，单位：字节。
# 31457280 = 30MB，适合短音频、短视频和 Swagger 联调。
MAX_UPLOAD_SIZE=31457280

# 容器内上传临时目录。Compose 会把宿主机 ./tmp/http-api 挂载到这里。
UPLOAD_TEMP_DIR=/app/tmp

# 日志级别。常用值：DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# 容器内日志文件路径。Compose 会把宿主机 ./logs/http-api 挂载到 /app/logs。
LOG_FILE=/app/logs/http-api.log

# 单个日志文件滚动大小。
LOG_ROTATION=100 MB

# 日志保留时间。
LOG_RETENTION=14 days
